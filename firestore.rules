rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jogadores - qualquer autenticado pode ler, criar e atualizar
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Partidas - autenticado pode ler e criar
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Duplas - autenticado pode ler e criar
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Partidas de duplas - autenticado pode ler e criar
    match /doublesMatches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Torneios - autenticado pode ler e criar
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Conquistas - autenticado pode ler e criar
    match /achievements/{achievementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Conquistas do jogador - autenticado pode ler e criar
    match /playerAchievements/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Convites de dupla - autenticado pode ler e escrever
    match /teamInvitations/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
